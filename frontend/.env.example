# ============================================================================
# DistribuTrack — Frontend environment variables
# Placeholders only — never commit real values.
# ============================================================================

# Backend API base URL (Vite dev server proxies /api by default; this is
# used when calling the API directly).
VITE_API_BASE_URL=http://localhost:8080/api

# Axios timeout in milliseconds.
VITE_API_TIMEOUT=15000

# Application display name.
VITE_APP_NAME=DistribuTrack

# development | staging | production
VITE_APP_ENV=development

# Reserved for future mock-API work — keep false.
VITE_ENABLE_MOCK_API=false
