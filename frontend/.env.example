# -----------------------------------------------------------------------------
# DistribuTrack — Environment Variables
# Copy this file to `.env.development` / `.env.production` and fill in values.
# All variables consumed by the client MUST be prefixed with VITE_.
# -----------------------------------------------------------------------------

# Base URL of the Spring Boot REST API (no trailing slash).
# Must match the backend's actual @RequestMapping root — AuthController
# is mapped at /api/auth, so the base URL is /api (no /v1).
VITE_API_BASE_URL=http://localhost:8080/api

# Request timeout in milliseconds
VITE_API_TIMEOUT=15000

# Application metadata
VITE_APP_NAME=DistribuTrack
VITE_APP_ENV=development

# Feature flags (optional, wire up as needed)
VITE_ENABLE_MOCK_API=false
