# ============================================================================
# DistribuTrack — Backend environment variables
# All values below are PLACEHOLDERS. Copy this file to your own environment
# (export the variables, use a secret manager, or a .env loader) and replace
# every value. NEVER commit real credentials.
# ============================================================================

# ----------------------------------------------------------------------------
# Database (MySQL)
# ----------------------------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/distributrack_db
DB_USERNAME=root
DB_PASSWORD=change-me

# ----------------------------------------------------------------------------
# JWT
# ----------------------------------------------------------------------------
# HS256 signing secret — must be at least 32 bytes in production.
APP_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# ----------------------------------------------------------------------------
# Payment gateway (Razorpay)
# ----------------------------------------------------------------------------
# Mode: mock (built-in dev gateway, no money), sandbox (Razorpay test
# environment), or live (production — only with real keys).
# When switching to sandbox/live, RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET,
# and RAZORPAY_WEBHOOK_SECRET MUST be set — the app will refuse to start
# without them.
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional override (defaults to https://api.razorpay.com/v1)
RAZORPAY_API_URL=https://api.razorpay.com/v1

# ----------------------------------------------------------------------------
# Email notifications (SMTP)
# ----------------------------------------------------------------------------
# Set EMAIL_ENABLED=true plus SMTP details for real email delivery.
# When EMAIL_ENABLED=false (default) every message is logged as [EMAIL MOCK].
# The app will WARN at startup if EMAIL_ENABLED=true but MAIL_HOST is missing.
EMAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_FROM=DistribuTrack <no-reply@yourdomain.com>

# ----------------------------------------------------------------------------
# SMS notifications
# ----------------------------------------------------------------------------
# provider: log (mock, default) or http (real gateway).
# When provider=http, SMS_API_URL and SMS_API_KEY MUST be set.
# The app will ERROR at startup if SMS_PROVIDER=http but SMS_API_URL is missing.
SMS_PROVIDER=log
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=DistribuTrack

# ----------------------------------------------------------------------------
# Distributor Identity
# ----------------------------------------------------------------------------
# UPI VPA for direct shopkeeper payments. Set via DISTRIBUTOR_UPI_ID.
# Example: yourname@okaxis, yourname@ybl, etc.
# The app will warn at startup if this is not set.
DISTRIBUTOR_UPI_ID=

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
SERVER_PORT=8080
